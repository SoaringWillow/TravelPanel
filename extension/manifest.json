{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "version": "1.0.0",
  "description": "Save travel inspiration to TravelPanel with one click",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to TravelPanel"
  },
  "background": {
    "service_worker": "background.js"
  }
}
