{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "short_name": "TravelPanel",
  "version": "1.0.0",
  "description": "Save travel inspiration from any webpage to your TravelPanel boards in one click.",
  "permissions": ["activeTab", "storage", "contextMenus", "windows"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to TravelPanel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
