{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "description": "Clip any travel inspiration page to your TravelPanel boards in one click.",
  "version": "1.0.0",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to TravelPanel"
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs"
  ]
}
