{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "version": "1.0.0",
  "description": "Save travel inspiration from any webpage to your TravelPanel boards. AI extracts locations + wisdom.",
  "minimum_chrome_version": "88",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to TravelPanel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "clip-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Clip current page to TravelPanel"
    }
  }
}
