{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "short_name": "TravelPanel",
  "version": "1.0.0",
  "description": "Clip travel inspiration from any webpage into your TravelPanel boards",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Clip to TravelPanel"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
