{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "version": "1.0.0",
  "description": "Save travel inspiration from any page — YouTube, Instagram, blogs — directly into TravelPanel.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to TravelPanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
