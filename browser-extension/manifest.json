{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "version": "1.0.0",
  "description": "Save travel inspiration from any webpage to your TravelPanel boards with one click.",
  "permissions": ["activeTab", "contextMenus", "storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Save to TravelPanel"
  },
  "background": {
    "service_worker": "background.js"
  }
}
