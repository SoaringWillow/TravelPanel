{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "version": "1.0.0",
  "description": "Save travel content to TravelPanel with one click. Clips any URL with AI-extracted locations and wisdom.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to TravelPanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": [],
  "commands": {
    "clip-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Save current page to TravelPanel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
