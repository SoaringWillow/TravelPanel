{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "description": "Clip travel inspiration from any webpage to your TravelPanel boards in one click.",
  "version": "1.0.0",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to TravelPanel",
    "default_icon": "icons/icon.svg"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
