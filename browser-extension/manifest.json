{
  "manifest_version": 3,
  "name": "TravelPanel — Save to Trip Board",
  "short_name": "TravelPanel",
  "version": "1.0.0",
  "description": "Clip travel inspiration from any page to your TravelPanel boards. Extracts locations, tips, and travel wisdom automatically.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Save to TravelPanel"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": []
}
