{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "description": "Clip any travel page to your TravelPanel boards with one click.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to TravelPanel",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "travelpanel-clipper@travelpanel.app",
      "strict_min_version": "109.0"
    }
  }
}
