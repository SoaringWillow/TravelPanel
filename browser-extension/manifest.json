{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "version": "1.0.0",
  "description": "Clip any travel post into your TravelPanel boards with one click.",
  "permissions": ["activeTab", "tabs", "storage", "contextMenus"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to TravelPanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
