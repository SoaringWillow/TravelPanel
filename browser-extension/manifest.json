{
  "manifest_version": 3,
  "name": "TravelPanel",
  "short_name": "TravelPanel",
  "description": "Save travel inspiration from any website into TravelPanel. AI extracts locations, tips, and wisdom automatically.",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to TravelPanel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
