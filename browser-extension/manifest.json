{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "version": "1.0.0",
  "description": "Clip travel inspiration from any webpage into TravelPanel — one click to extract spots and wisdom.",
  "permissions": ["activeTab", "tabs", "storage", "contextMenus"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to TravelPanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
