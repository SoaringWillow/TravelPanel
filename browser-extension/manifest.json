{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "description": "Clip any travel URL into TravelPanel with one click. Extracts locations, tips, and wisdom from travel posts.",
  "version": "1.0.0",
  "permissions": ["activeTab", "storage", "contextMenus", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    },
    "default_title": "Clip to TravelPanel"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "commands": {
    "clip-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Clip the current tab to TravelPanel"
    }
  }
}
