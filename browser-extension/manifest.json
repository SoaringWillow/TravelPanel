{
  "manifest_version": 3,
  "name": "TravelPanel Clipper",
  "version": "1.0.0",
  "description": "Save travel inspiration from any webpage to TravelPanel with one click.",
  "permissions": ["activeTab", "contextMenus", "storage", "windows"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to TravelPanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
