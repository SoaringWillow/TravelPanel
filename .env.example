# TravelPanel — environment variables
# Copy to .env.local and fill in. Every key is OPTIONAL: the app runs fully
# local-first with none of them. Each integration stays dormant until its key
# is provided (no crashes, no degraded UX).

# ─── AI (required for clip extraction + trip planning) ───────────────────────
# Anthropic API key — powers /api/import (enrichment) and /api/plan (itinerary).
ANTHROPIC_API_KEY=

# ─── Cloud sync + auth (Phase B1 — Supabase) ─────────────────────────────────
# When both are set, cloud sync + magic-link/Google auth activate.
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser; RLS protects rows per-user).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Analytics (Phase A3 — PostHog) ──────────────────────────────────────────
# North Star metric tracking. No-ops entirely when absent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Email notifications (Resend) ────────────────────────────────────────────
# Resource-request emails. Falls back to a mailto: link when absent.
RESEND_API_KEY=

# ─── iOS native shell (Capacitor) ────────────────────────────────────────────
# URL the native app loads. Set per build; see CLAUDE.md "iOS Build Workflow".
CAPACITOR_SERVER_URL=
