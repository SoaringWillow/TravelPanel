{
  "name": "TravelPanel",
  "short_name": "TravelPanel",
  "description": "Capture travel inspiration and plan AI-powered trips",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#6366f1",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "url": "url",
      "text": "text",
      "title": "title"
    }
  },
  "categories": ["travel", "productivity", "lifestyle"],
  "screenshots": [
    {
      "src": "/screenshot-map.png",
      "sizes": "390x844",
      "type": "image/png",
      "label": "Map view with saved travel clips",
      "form_factor": "narrow"
    }
  ]
}
