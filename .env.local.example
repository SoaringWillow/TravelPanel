# TravelPanel — environment variables
# Copy to .env.local and fill in. Every key is OPTIONAL except ANTHROPIC_API_KEY:
# the app runs local-first and each integration stays dormant until its key is
# present (no crashes, no degraded UX).

# ── Anthropic (required — clip extraction + trip planning) ──
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Supabase (optional — Phase B1 cloud sync + auth) ──
# Free tier: https://supabase.com. When BOTH are set, cloud sync + magic-link/
# Google auth activate. Until then the app stays fully local-first (no-ops).
# The anon key is safe to expose to the browser; per-user RLS protects rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── PostHog (optional — analytics / North Star metric) ──
# Free tier: https://posthog.com. No-ops entirely when absent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Resend (optional — resource-request emails) ──
# Free tier: https://resend.com. Falls back to a mailto: link when absent.
RESEND_API_KEY=
NOTIFY_EMAIL=jiangnan027@gmail.com

# ── Sentry (optional — error tracking + native crash reporting) ──
# Free tier: https://sentry.io. No-ops entirely when absent.
NEXT_PUBLIC_SENTRY_DSN=

# ── Capacitor (iOS native shell) ──
# URL the native app loads. Set per build; see CLAUDE.md "iOS Build Workflow".
CAPACITOR_SERVER_URL=
